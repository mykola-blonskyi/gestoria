# Copy to .env (ignored by git) next to compose.yaml. The database holds personal financial data (SPEC-013): pick a long
# random password, for example with `openssl rand -hex 24`, and use the same one in the API's connection string.
POSTGRES_PASSWORD=
# The host port the database listens on, on 127.0.0.1 only. Change it if 5432 is taken.
POSTGRES_PORT=5432
