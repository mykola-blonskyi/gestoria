<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GestorIA.Domain\GestorIA.Domain.csproj" />
    <ProjectReference Include="..\GestorIA.Engine\GestorIA.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Raises the EF Core that Npgsql brings (10.0.4) to the Design package's and the dotnet-ef tool's version. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- What `dotnet ef migrations add` loads to write a migration; nothing of it ships with the API. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\config\tax-years\schema.json" LogicalName="GestorIA.Infrastructure.TaxYears.schema.json" />
  </ItemGroup>

</Project>
