    "/api/v1/profiles/{id}/calculations/annual-true-up": {
      "post": {
        "tags": [
          "periods"
        ],
        "summary": "Runs the set-aside estimator on a stored profile and returns the annual true-up gap, due window and trace.",
        "operationId": "calculateAnnualTrueUp",
        "parameters": [
          {
            "name": "id",
            "in": "path",
