{
  "openapi": "3.1.1",
  "info": {
    "title": "GestorIA API",
    "description": "SPEC-009. Money is a string with two decimals, dates are ISO-8601, errors are RFC 9457 problem+json.",
    "version": "1.0.0"
  },
