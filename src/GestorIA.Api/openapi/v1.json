  },
  "components": {
    "schemas": {
      "ActivityDocument": {
        "required": [
          "retenciones",
          "actuals",
          "projection"
        ],
        "type": "object",
        "properties": {
          "retenciones": {
            "$ref": "#/components/schemas/RetencionesDocument"
          },
          "actuals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuarterToDateDocument"
            }
          },
          "projection": {
            "$ref": "#/components/schemas/ProjectionDocument"
          }
        },
        "additionalProperties": false
      },
      "AnnualTrueUpView": {
        "required": [
          "taxYear",
          "configHash",
          "liabilityOnActivity",
          "marginalRate",
          "reduccionTrabajoLost",
          "gap",
          "dueFrom",
          "dueBy",
          "payableIn",
          "trace",
          "notices"
        ],
        "type": "object",
        "properties": {
          "taxYear": {
            "type": "integer",
            "format": "int32"
          },
          "configHash": {
            "type": "string"
          },
          "liabilityOnActivity": {
            "type": "string"
          },
          "marginalRate": {
            "type": "string"
          },
          "reduccionTrabajoLost": {
            "type": "string"
          },
          "gap": {
            "type": "string"
          },
          "dueFrom": {
            "type": "string",
            "format": "date"
          },
          "dueBy": {
            "type": "string",
            "format": "date"
          },
          "payableIn": {
            "type": "string"
          },
          "trace": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TraceStepView"
            }
          },
          "notices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NoticeView"
            }
          }
        }
      },
      "CasillaView": {
        "required": [
          "key",
          "amount"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          }
        }
      },
      "DeclaredGap": {
        "required": [
          "entry",
          "note"
        ],
        "type": "object",
        "properties": {
          "entry": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "EmploymentDocument": {
        "required": [
          "ingresos",
          "seguridadSocial"
        ],
        "type": "object",
        "properties": {
          "ingresos": {
            "pattern": "^\\d+(\\.\\d+)?$",
            "type": "string"
          },
          "seguridadSocial": {
            "pattern": "^\\d+(\\.\\d+)?$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ExportedBankTransaction": {
        "required": [
          "id",
          "bookingDate",
          "valueDate",
          "description",
          "amount",
          "balance",
          "importSequence",
          "lineNumber",
          "lineKey"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "bookingDate": {
            "type": "string",
            "format": "date"
          },
          "valueDate": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string"
          },
          "amount": {
            "pattern": "^-?\\d+\\.\\d{2}$",
            "type": "string"
          },
          "balance": {
            "pattern": "^-?\\d+\\.\\d{2}$",
            "type": [
              "null",
              "string"
            ]
          },
          "importSequence": {
            "type": "integer",
            "format": "int32"
          },
          "lineNumber": {
            "type": "integer",
            "format": "int32"
          },
          "lineKey": {
            "type": "string"
          }
        }
      },
      "ExportedEntities": {
        "required": [
          "profiles",
          "bankTransactions"
        ],
        "type": "object",
        "properties": {
          "profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProfileView"
            }
          },
          "bankTransactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExportedBankTransaction"
            }
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "NewActivityChoice": {
        "required": [
          "kind"
        ],
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/NewActivityChoiceEstablishedActivity"
          },
          {
            "$ref": "#/components/schemas/NewActivityChoiceNewActivityStarted"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "established": "#/components/schemas/NewActivityChoiceEstablishedActivity",
            "started": "#/components/schemas/NewActivityChoiceNewActivityStarted"
          }
        }
      },
      "NewActivityChoiceEstablishedActivity": {
        "properties": {
          "kind": {
            "enum": [
              "established"
            ],
            "type": "string"
          }
        }
      },
      "NewActivityChoiceNewActivityStarted": {
        "required": [
          "period",
          "ingresosFromFormerEmployer"
        ],
        "properties": {
          "kind": {
            "enum": [
              "started"
            ],
            "type": "string"
          },
          "period": {
            "$ref": "#/components/schemas/StartedPeriod"
          },
          "ingresosFromFormerEmployer": {
            "pattern": "^[0-9]{1,12}(\\.[0-9]{1,2})?$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "NewActivityDocument": {
        "oneOf": [
          {
