{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gestoria.local/config/tax-years/schema/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taxYear",
    "schemaVersion",
    "sources",
    "irpf",
    "regions",
    "modelo130",
    "modelo303",
    "iva",
    "seguridadSocial",
    "calendar",
    "casillas",
    "deducciones"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "taxYear": { "type": "integer", "minimum": 2000, "maximum": 2100 },
    "schemaVersion": { "const": 1 },
    "sources": { "type": "array", "minItems": 1 },
    "irpf": { "type": "object" },
    "regions": { "type": "object" },
    "modelo130": { "type": "object" },
    "modelo303": { "type": "object" },
    "modelo349": { "type": "object" },
    "iva": { "type": "object" },
    "seguridadSocial": { "type": "object" },
    "calendar": { "type": "object" },
    "casillas": { "type": "object" },
    "deducciones": { "type": "array" },
    "provenance": { "type": "object" }
  }
}
