{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gestoria.local/config/tax-years/schema/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taxYear",
    "schemaVersion",
    "sources",
    "irpf",
    "regions",
    "modelo130",
    "modelo303",
    "iva",
    "seguridadSocial",
    "calendar",
    "casillas",
    "deducciones"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "taxYear": { "type": "integer", "minimum": 2000, "maximum": 2100 },
    "schemaVersion": { "const": 1 },
    "sources": { "type": "array", "minItems": 1 },
    "irpf": { "type": "object" },
    "regions": { "type": "object" },
    "modelo130": { "type": "object" },
    "modelo303": { "type": "object" },
    "modelo349": { "type": "object" },
    "iva": { "type": "object" },
    "seguridadSocial": { "type": "object" },
    "calendar": { "type": "object" },
    "casillas": { "type": "object" },
    "deducciones": { "type": "array" },
    "provenance": { "type": "object" }
  },
  "$defs": {
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "money": {"type": "number", "minimum": 0},
    "years":    { "type": "integer", "minimum": 0 },
    "factor":   { "type": "number", "exclusiveMinimum": 0 },
    "todoNote": { "type": "string", "minLength": 1 },

    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },

    "tranche": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upTo", "rate"],
      "properties": {
        "upTo": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "rate": { "$ref": "#/$defs/rate" }
      }
    },

    "scale": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tranche" }
    },

    "calendarDay": {
      "type": "string",
      "pattern": "^(\\+1-)?(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },

    "window": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/calendarDay" },
        { "$ref": "#/$defs/calendarDay" }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
