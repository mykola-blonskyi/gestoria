{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gestoria.local/config/tax-years/schema/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taxYear",
    "schemaVersion",
    "sources",
    "irpf",
    "regions",
    "modelo130",
    "modelo303",
    "iva",
    "seguridadSocial",
    "calendar",
    "casillas",
    "deducciones"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "taxYear": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100
    },
    "schemaVersion": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "irpf": {
      "$ref": "#/$defs/irpf"
    },
    "regions": {
      "$ref": "#/$defs/regions"
    },
    "modelo130": {
      "type": "object"
    },
    "modelo303": {
      "type": "object"
    },
    "modelo349": {
      "type": "object"
    },
    "iva": {
      "type": "object"
    },
    "seguridadSocial": {
      "type": "object"
    },
    "calendar": {
      "$ref": "#/$defs/calendar"
    },
    "casillas": {
      "$ref": "#/$defs/casillas"
    },
    "deducciones": {
      "type": "array"
    },
    "provenance": {
      "type": "object"
    }
  },
  "$defs": {
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "money": {
      "type": "number",
      "minimum": 0
    },
    "years": {
      "type": "integer",
      "minimum": 0
    },
    "factor": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "todoNote": {
      "type": "string",
      "minLength": 1
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        }
      }
    },
    "tranche": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upTo",
        "rate"
      ],
      "properties": {
        "upTo": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "rate": {
          "$ref": "#/$defs/rate"
        }
      }
    },
    "scale": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/tranche"
      }
    },
    "calendarDay": {
      "type": "string",
      "pattern": "^(\\+1-)?(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "window": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/calendarDay"
        },
        {
          "$ref": "#/$defs/calendarDay"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "irpf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "escalaEstatal",
        "escalaAhorro",
        "minimos",
        "trabajo",
        "actividad",
        "ahorro",
        "inmuebles",
        "reducciones",
        "obligacion"
      ],
      "properties": {
        "escalaEstatal": {
          "$ref": "#/$defs/scale"
        },
        "escalaAhorro": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "combined",
            "estatalShare"
          ],
          "properties": {
            "combined": {
              "$ref": "#/$defs/scale"
            },
            "estatalShare": {
              "$ref": "#/$defs/rate"
            }
          }
        },
        "minimos": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contribuyente",
            "mayor65",
            "mayor75",
            "descendientes",
            "menor3",
            "ascendiente",
            "ascendiente75",
            "discapacidad33",
            "discapacidad65",
            "asistencia",
            "descendienteIncomeCap",
            "descendienteAgeCap"
          ],
          "properties": {
            "contribuyente": {
              "$ref": "#/$defs/money"
            },
            "mayor65": {
              "$ref": "#/$defs/money"
            },
            "mayor75": {
              "$ref": "#/$defs/money"
            },
            "descendientes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/money"
              }
            },
            "menor3": {
              "$ref": "#/$defs/money"
            },
            "ascendiente": {
              "$ref": "#/$defs/money"
            },
            "ascendiente75": {
              "$ref": "#/$defs/money"
            },
            "discapacidad33": {
              "$ref": "#/$defs/money"
            },
            "discapacidad65": {
              "$ref": "#/$defs/money"
            },
            "asistencia": {
              "$ref": "#/$defs/money"
            },
            "descendienteIncomeCap": {
              "$ref": "#/$defs/money"
            },
            "descendienteAgeCap": {
              "$ref": "#/$defs/years"
            }
          }
        },
        "trabajo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "otrosGastos",
            "movilidadExtra",
            "discapacidadExtra",
            "discapacidadExtra65",
            "unionFeeCap",
            "reduccion"
          ],
          "properties": {
            "otrosGastos": {
              "$ref": "#/$defs/money"
            },
            "movilidadExtra": {
              "$ref": "#/$defs/money"
            },
            "discapacidadExtra": {
              "$ref": "#/$defs/money"
            },
            "discapacidadExtra65": {
              "$ref": "#/$defs/money"
            },
            "unionFeeCap": {
              "$ref": "#/$defs/money"
            },
            "reduccion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fixed",
                "t1",
                "t2",
                "t3",
                "k1",
                "k2",
                "otherIncomeCap"
              ],
              "properties": {
                "fixed": {
                  "$ref": "#/$defs/money"
                },
                "t1": {
                  "$ref": "#/$defs/money"
                },
                "t2": {
                  "$ref": "#/$defs/money"
                },
                "t3": {
                  "$ref": "#/$defs/money"
                },
                "k1": {
                  "$ref": "#/$defs/factor"
                },
                "k2": {
                  "$ref": "#/$defs/factor"
                },
                "otherIncomeCap": {
                  "$ref": "#/$defs/money"
                }
              }
            }
          }
        },
        "actividad": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dificilJustificacion",
            "homeUtilitiesFactor",
            "retencionProfesional",
            "retencionNuevo",
            "retencionNuevoYears",
            "depreciation"
          ],
          "properties": {
            "dificilJustificacion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pct",
                "max"
              ],
              "properties": {
                "pct": {
                  "$ref": "#/$defs/rate"
                },
                "max": {
                  "$ref": "#/$defs/money"
                }
              }
            },
            "homeUtilitiesFactor": {
              "$ref": "#/$defs/rate"
            },
            "retencionProfesional": {
              "$ref": "#/$defs/rate"
            },
            "retencionNuevo": {
              "$ref": "#/$defs/rate"
            },
            "retencionNuevoYears": {
              "$ref": "#/$defs/years"
            },
            "depreciation": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "#/$defs/years"
              }
            }
          }
        },
        "ahorro": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lossOffsetPct",
            "carryForwardYears"
          ],
          "properties": {
            "lossOffsetPct": {
              "$ref": "#/$defs/rate"
            },
            "carryForwardYears": {
              "$ref": "#/$defs/years"
            }
          }
        },
        "inmuebles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "imputacionPct",
            "imputacionPctRevisado",
            "rentalReductionPct",
            "depreciationPct"
          ],
          "properties": {
            "imputacionPct": {
              "$ref": "#/$defs/rate"
            },
            "imputacionPctRevisado": {
              "$ref": "#/$defs/rate"
            },
            "rentalReductionPct": {
              "$ref": "#/$defs/rate"
            },
            "depreciationPct": {
              "$ref": "#/$defs/rate"
            }
          }
        },
        "reducciones": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "planPensionesCap",
            "conjuntaBiparental",
            "conjuntaMonoparental"
          ],
          "properties": {
            "planPensionesCap": {
              "$ref": "#/$defs/money"
            },
            "conjuntaBiparental": {
              "$ref": "#/$defs/money"
            },
            "conjuntaMonoparental": {
              "$ref": "#/$defs/money"
            }
          }
        },
        "obligacion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unPagador",
            "variosPagadores",
            "segundoPagadorMin",
            "ahorroCap",
            "imputadasCap"
          ],
          "properties": {
            "unPagador": {
              "$ref": "#/$defs/money"
            },
            "variosPagadores": {
              "$ref": "#/$defs/money"
            },
            "segundoPagadorMin": {
              "$ref": "#/$defs/money"
            },
            "ahorroCap": {
              "$ref": "#/$defs/money"
            },
            "imputadasCap": {
              "$ref": "#/$defs/money"
            }
          }
        }
      }
    },
    "regions": {
      "type": "object",
      "required": [
        "VC"
      ],
      "propertyNames": {
        "pattern": "^[A-Z]{2}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "escalaAutonomica",
          "minimosOverride"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "escalaAutonomica": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/tranche"
            }
          },
          "minimosOverride": {
            "type": [
              "object",
              "null"
            ]
          },
          "_todo": {
            "$ref": "#/$defs/todoNote"
          }
        }
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelo130",
        "renta",
        "holidays"
      ],
      "properties": {
        "modelo130": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/window"
          }
        },
        "renta": {
          "$ref": "#/$defs/window"
        },
        "holidays": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/calendarDay"
          }
        }
      }
    },
    "casillas": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[0-9]{4}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
