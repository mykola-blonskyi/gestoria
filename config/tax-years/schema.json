{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gestoria.local/config/tax-years/schema/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taxYear",
    "schemaVersion",
    "sources",
    "irpf",
    "regions",
    "modelo130",
    "modelo303",
    "modelo349",
    "iva",
    "seguridadSocial",
    "calendar",
    "casillas",
    "deducciones",
    "provenance"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "taxYear": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100
    },
    "schemaVersion": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "irpf": {
      "$ref": "#/$defs/irpf"
    },
    "regions": {
      "$ref": "#/$defs/regions"
    },
    "modelo130": {
      "$ref": "#/$defs/modelo130"
    },
    "modelo303": {
      "$ref": "#/$defs/modelo303"
    },
    "modelo349": {
      "$ref": "#/$defs/modelo349"
    },
    "iva": {
      "$ref": "#/$defs/iva"
    },
    "seguridadSocial": {
      "$ref": "#/$defs/seguridadSocial"
    },
    "calendar": {
      "$ref": "#/$defs/calendar"
    },
    "casillas": {
      "$ref": "#/$defs/casillas"
    },
    "deducciones": {
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "money": {
      "type": "number",
      "minimum": 0
    },
    "years": {
      "type": "integer",
      "minimum": 0
    },
    "factor": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "casilla": {
      "type": "string",
      "pattern": "^[0-9]{2,3}$"
    },
    "baseCuota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "cuota"
      ],
      "properties": {
        "base": {
          "$ref": "#/$defs/casilla"
        },
        "cuota": {
          "$ref": "#/$defs/casilla"
        }
      }
    },
    "baseTipoCuota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "tipo",
        "cuota"
      ],
      "properties": {
        "base": {
          "$ref": "#/$defs/casilla"
        },
        "tipo": {
          "$ref": "#/$defs/casilla"
        },
        "cuota": {
          "$ref": "#/$defs/casilla"
        }
      }
    },
    "fieldPositions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 1
        },
        "to": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "todoNote": {
      "type": "string",
      "minLength": 1
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        }
      }
    },
    "tranche": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upTo",
        "rate"
      ],
      "properties": {
        "upTo": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "rate": {
          "$ref": "#/$defs/rate"
        }
      }
    },
    "scale": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/tranche"
      }
    },
    "minoracionBand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prevYearNetUpTo",
        "amountPerQuarter"
      ],
      "properties": {
        "prevYearNetUpTo": {
          "$ref": "#/$defs/money"
        },
        "amountPerQuarter": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "tramo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "netFrom",
        "netUpTo",
        "baseMin",
        "baseMax",
        "cuotaMin",
        "cuotaMinKind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "netFrom": {
          "$ref": "#/$defs/money"
        },
        "netUpTo": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "baseMin": {
          "$ref": "#/$defs/money"
        },
        "baseMax": {
          "$ref": "#/$defs/money"
        },
        "cuotaMin": {
          "$ref": "#/$defs/money"
        },
        "cuotaMinKind": {
          "enum": [
            "approximate",
            "exact"
          ]
        }
      }
    },
    "calendarDay": {
      "type": "string",
      "pattern": "^(\\+1-)?(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "window": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/calendarDay"
        },
        {
          "$ref": "#/$defs/calendarDay"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "irpf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "escalaEstatal",
        "escalaAhorro",
        "minimos",
        "trabajo",
        "actividad",
        "ahorro",
        "inmuebles",
        "reducciones",
        "obligacion"
      ],
      "properties": {
        "escalaEstatal": {
          "$ref": "#/$defs/scale"
        },
        "escalaAhorro": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "combined",
            "estatalShare"
          ],
          "properties": {
            "combined": {
              "$ref": "#/$defs/scale"
            },
            "estatalShare": {
              "$ref": "#/$defs/rate"
            }
          }
        },
        "minimos": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contribuyente",
            "mayor65",
            "mayor75",
            "descendientes",
            "menor3",
            "ascendiente",
            "ascendiente75",
            "discapacidad33",
            "discapacidad65",
            "asistencia",
            "descendienteIncomeCap",
            "descendienteAgeCap"
          ],
          "properties": {
            "contribuyente": {
              "$ref": "#/$defs/money"
            },
            "mayor65": {
              "$ref": "#/$defs/money"
            },
            "mayor75": {
              "$ref": "#/$defs/money"
            },
            "descendientes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/money"
              }
            },
            "menor3": {
              "$ref": "#/$defs/money"
            },
            "ascendiente": {
              "$ref": "#/$defs/money"
            },
            "ascendiente75": {
              "$ref": "#/$defs/money"
            },
            "discapacidad33": {
              "$ref": "#/$defs/money"
            },
            "discapacidad65": {
              "$ref": "#/$defs/money"
            },
            "asistencia": {
              "$ref": "#/$defs/money"
            },
            "descendienteIncomeCap": {
              "$ref": "#/$defs/money"
            },
            "descendienteAgeCap": {
              "$ref": "#/$defs/years"
            }
          }
        },
        "trabajo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "otrosGastos",
            "movilidadExtra",
            "discapacidadExtra",
            "discapacidadExtra65",
            "colegioFeeCap",
            "reduccion"
          ],
          "properties": {
            "otrosGastos": {
              "$ref": "#/$defs/money"
            },
            "movilidadExtra": {
              "$ref": "#/$defs/money"
            },
            "discapacidadExtra": {
              "$ref": "#/$defs/money"
            },
            "discapacidadExtra65": {
              "$ref": "#/$defs/money"
            },
            "colegioFeeCap": {
              "$ref": "#/$defs/money"
            },
            "reduccion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fixed",
                "t1",
                "t2",
                "t3",
                "k1",
                "k2",
                "otherIncomeCap"
              ],
              "properties": {
                "fixed": {
                  "$ref": "#/$defs/money"
                },
                "t1": {
                  "$ref": "#/$defs/money"
                },
                "t2": {
                  "$ref": "#/$defs/money"
                },
                "t3": {
                  "$ref": "#/$defs/money"
                },
                "k1": {
                  "$ref": "#/$defs/factor"
                },
                "k2": {
                  "$ref": "#/$defs/factor"
                },
                "otherIncomeCap": {
                  "$ref": "#/$defs/money"
                }
              }
            }
          }
        },
        "actividad": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dificilJustificacion",
            "inicioActividad",
            "homeUtilitiesFactor",
            "retencionProfesional",
            "retencionNuevo",
            "retencionNuevoYears",
            "depreciation"
          ],
          "properties": {
            "dificilJustificacion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pct",
                "max"
              ],
              "properties": {
                "pct": {
                  "$ref": "#/$defs/rate"
                },
                "max": {
                  "$ref": "#/$defs/money"
                }
              }
            },
            "inicioActividad": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pct",
                "maxRendimiento",
                "formerEmployerShare"
              ],
              "properties": {
                "pct": {
                  "$ref": "#/$defs/rate"
                },
                "maxRendimiento": {
                  "$ref": "#/$defs/money"
                },
                "formerEmployerShare": {
                  "$ref": "#/$defs/rate"
                }
              }
            },
            "homeUtilitiesFactor": {
              "$ref": "#/$defs/rate"
            },
            "retencionProfesional": {
              "$ref": "#/$defs/rate"
            },
            "retencionNuevo": {
              "$ref": "#/$defs/rate"
            },
            "retencionNuevoYears": {
              "$ref": "#/$defs/years"
            },
            "depreciation": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "#/$defs/years"
              }
            }
          }
        },
        "ahorro": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lossOffsetPct",
            "carryForwardYears"
          ],
          "properties": {
            "lossOffsetPct": {
              "$ref": "#/$defs/rate"
            },
            "carryForwardYears": {
              "$ref": "#/$defs/years"
            }
          }
        },
        "inmuebles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "imputacionPct",
            "imputacionPctRevisado",
            "rentalReductionPct",
            "depreciationPct"
          ],
          "properties": {
            "imputacionPct": {
              "$ref": "#/$defs/rate"
            },
            "imputacionPctRevisado": {
              "$ref": "#/$defs/rate"
            },
            "rentalReductionPct": {
              "$ref": "#/$defs/rate"
            },
            "depreciationPct": {
              "$ref": "#/$defs/rate"
            }
          }
        },
        "reducciones": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "planPensionesCap",
            "conjuntaBiparental",
            "conjuntaMonoparental"
          ],
          "properties": {
            "planPensionesCap": {
              "$ref": "#/$defs/money"
            },
            "conjuntaBiparental": {
              "$ref": "#/$defs/money"
            },
            "conjuntaMonoparental": {
              "$ref": "#/$defs/money"
            }
          }
        },
        "obligacion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unPagador",
            "variosPagadores",
            "segundoPagadorMin",
            "ahorroCap",
            "imputadasCap"
          ],
          "properties": {
            "unPagador": {
              "$ref": "#/$defs/money"
            },
            "variosPagadores": {
              "$ref": "#/$defs/money"
            },
            "segundoPagadorMin": {
              "$ref": "#/$defs/money"
            },
            "ahorroCap": {
              "$ref": "#/$defs/money"
            },
            "imputadasCap": {
              "$ref": "#/$defs/money"
            }
          }
        }
      }
    },
    "regions": {
      "type": "object",
      "required": [
        "VC"
      ],
      "propertyNames": {
        "pattern": "^[A-Z]{2}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "escalaAutonomica",
          "minimosOverride",
          "holidays"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "escalaAutonomica": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/tranche"
            }
          },
          "minimosOverride": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "contribuyente",
              "mayor65",
              "mayor75",
              "descendientes",
              "menor3",
              "ascendiente",
              "ascendiente75",
              "discapacidad33",
              "discapacidad65",
              "asistencia"
            ],
            "properties": {
              "contribuyente": {
                "$ref": "#/$defs/money"
              },
              "mayor65": {
                "$ref": "#/$defs/money"
              },
              "mayor75": {
                "$ref": "#/$defs/money"
              },
              "descendientes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/money"
                }
              },
              "menor3": {
                "$ref": "#/$defs/money"
              },
              "ascendiente": {
                "$ref": "#/$defs/money"
              },
              "ascendiente75": {
                "$ref": "#/$defs/money"
              },
              "discapacidad33": {
                "$ref": "#/$defs/money"
              },
              "discapacidad65": {
                "$ref": "#/$defs/money"
              },
              "asistencia": {
                "$ref": "#/$defs/money"
              }
            }
          },
          "holidays": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/calendarDay"
            }
          },
          "_todo": {
            "$ref": "#/$defs/todoNote"
          }
        },
        "if": {
          "not": {
            "required": [
              "_todo"
            ]
          }
        },
        "then": {
          "properties": {
            "escalaAutonomica": {
              "minItems": 1
            },
            "holidays": {
              "minItems": 1
            }
          }
        }
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelo130",
        "renta",
        "holidays"
      ],
      "properties": {
        "modelo130": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/window"
          }
        },
        "renta": {
          "anyOf": [
            {
              "$ref": "#/$defs/window"
            },
            {
              "type": "null"
            }
          ]
        },
        "holidays": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/calendarDay"
          }
        },
        "_todo": {
          "$ref": "#/$defs/todoNote"
        }
      },
      "if": {
        "not": {
          "required": [
            "_todo"
          ]
        }
      },
      "then": {
        "properties": {
          "renta": {
            "type": "array"
          }
        }
      }
    },
    "casillas": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^([0-9]{4}|_todo)$"
      },
      "properties": {
        "_todo": {
          "$ref": "#/$defs/todoNote"
        }
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "seguridadSocial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tramos",
        "tarifaPlana",
        "gastosGenericos"
      ],
      "properties": {
        "tramos": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tramo"
          }
        },
        "tarifaPlana": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "months",
            "extensionMonths",
            "extensionNetIncomeCap"
          ],
          "properties": {
            "amount": {
              "anyOf": [
                {
                  "$ref": "#/$defs/money"
                },
                {
                  "type": "null"
                }
              ]
            },
            "months": {
              "$ref": "#/$defs/years"
            },
            "extensionMonths": {
              "$ref": "#/$defs/years"
            },
            "extensionNetIncomeCap": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "_todo": {
              "$ref": "#/$defs/todoNote"
            }
          },
          "if": {
            "not": {
              "required": [
                "_todo"
              ]
            }
          },
          "then": {
            "properties": {
              "amount": {
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "amount": {
                "type": "null"
              }
            }
          }
        },
        "gastosGenericos": {
          "$ref": "#/$defs/rate",
          "exclusiveMaximum": 1
        },
        "_todo": {
          "$ref": "#/$defs/todoNote"
        }
      },
      "if": {
        "not": {
          "required": [
            "_todo"
          ]
        }
      },
      "then": {
        "properties": {
          "tramos": {
            "minItems": 1
          }
        }
      }
    },
    "modelo303Lines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "devengado": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "superreducido",
            "reducido",
            "general",
            "adquisicionesIntracomunitarias",
            "total"
          ],
          "properties": {
            "superreducido": {
              "$ref": "#/$defs/baseTipoCuota"
            },
            "reducido": {
              "$ref": "#/$defs/baseTipoCuota"
            },
            "general": {
              "$ref": "#/$defs/baseTipoCuota"
            },
            "adquisicionesIntracomunitarias": {
              "$ref": "#/$defs/baseCuota"
            },
            "total": {
              "$ref": "#/$defs/casilla"
            }
          }
        },
        "deducible": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operacionesInteriores",
            "adquisicionesIntracomunitarias",
            "total"
          ],
          "properties": {
            "operacionesInteriores": {
              "$ref": "#/$defs/baseCuota"
            },
            "adquisicionesIntracomunitarias": {
              "$ref": "#/$defs/baseCuota"
            },
            "total": {
              "$ref": "#/$defs/casilla"
            }
          }
        },
        "resultadoRegimenGeneral": {
          "$ref": "#/$defs/casilla"
        },
        "entregasIntracomunitarias": {
          "$ref": "#/$defs/casilla"
        },
        "noSujetasLocalizacion": {
          "$ref": "#/$defs/casilla"
        },
        "sumaResultados": {
          "$ref": "#/$defs/casilla"
        },
        "porcentajeEstado": {
          "$ref": "#/$defs/casilla"
        },
        "atribuibleEstado": {
          "$ref": "#/$defs/casilla"
        },
        "compensarPendientes": {
          "$ref": "#/$defs/casilla"
        },
        "compensarAplicadas": {
          "$ref": "#/$defs/casilla"
        },
        "compensarPosteriores": {
          "$ref": "#/$defs/casilla"
        },
        "resultadoAutoliquidacion": {
          "$ref": "#/$defs/casilla"
        },
        "resultado": {
          "$ref": "#/$defs/casilla"
        },
        "aCompensar": {
          "$ref": "#/$defs/casilla"
        },
        "aDevolver": {
          "$ref": "#/$defs/casilla"
        },
        "_todo": {
          "$ref": "#/$defs/todoNote"
        }
      },
      "if": {
        "not": {
          "required": [
            "_todo"
          ]
        }
      },
      "then": {
        "required": [
          "devengado",
          "deducible",
          "resultadoRegimenGeneral",
          "entregasIntracomunitarias",
          "noSujetasLocalizacion",
          "sumaResultados",
          "porcentajeEstado",
          "atribuibleEstado",
          "compensarPendientes",
          "compensarAplicadas",
          "compensarPosteriores",
          "resultadoAutoliquidacion",
          "resultado",
          "aCompensar",
          "aDevolver"
        ]
      },
      "else": {
        "maxProperties": 1
      }
    },
    "modelo303": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lines"
      ],
      "properties": {
        "lines": {
          "$ref": "#/$defs/modelo303Lines"
        }
      }
    },
    "modelo130Lines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ingresos": {
          "$ref": "#/$defs/casilla"
        },
        "gastos": {
